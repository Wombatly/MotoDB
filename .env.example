SECRET_KEY=bitte-durch-einen-langen-zufaelligen-wert-ersetzen

# Fuer oeffentliche HTTPS-Deployments aktivieren.
# MOTODB_PUBLIC_HOSTING=true
# MOTODB_TRUST_PROXY_HEADERS=true

# Oeffentliche Selbstregistrierung bleibt im Public-Hosting-Modus aus,
# solange sie nicht bewusst aktiviert wird.
# MOTODB_ALLOW_REGISTRATION=false

# Maximaler Upload-Speicher pro Account in MB (Standard: 500).
# Aenderung wird nach einem Neustart des Containers wirksam.
# MOTODB_MAX_STORAGE_MB=500

# Bootstrap fuer den ersten Admin einer neuen Public-Hosting-Datenbank.
# Nach dem ersten erfolgreichen Start koennen diese Werte entfernt werden.
# MOTODB_ADMIN_USERNAME=admin
# MOTODB_ADMIN_EMAIL=admin@example.com
# MOTODB_ADMIN_PASSWORD=bitte-mindestens-12-zeichen
